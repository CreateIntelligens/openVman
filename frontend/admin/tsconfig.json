{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@contracts/*": ["../../contracts/*"],
      "@shared/*": ["../shared/*"],
      "@ricky0123/vad-web": ["node_modules/@ricky0123/vad-web"]
    }
  },
  "include": ["src", "../../contracts/schemas/v1/**/*.json", "../../contracts/generated/typescript/**/*.d.ts", "../shared/**/*"],
  "exclude": [
    "../shared/**/*.test.ts",
    "../shared/**/*.spec.ts"
  ]
}
