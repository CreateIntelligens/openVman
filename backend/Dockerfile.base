# syntax=docker/dockerfile:1.7
#
# openvman-backend-base: everything in the backend image that is slow to build
# and rarely changes. Published separately (see .github/workflows/docker-publish.yml)
# so the per-commit backend build only installs requirements.txt and copies app/.
#
# Rebuild when this file changes: the CI job diffs it against the previous commit.
# Locally: docker build -f backend/Dockerfile.base -t tbdavid2019/openvman-backend-base:latest backend

# Stage 1: builder — toolchain needed to compile the parser stack (pdf-inspector is
# a Rust extension with no published wheel), thrown away after /opt/venv is built.
FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/opt/venv/bin:/usr/local/cargo/bin:$PATH" \
    VIRTUAL_ENV=/opt/venv

RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.88.0 \
    && rustc --version \
    && cargo --version

RUN pip install --no-cache-dir --upgrade pip setuptools wheel uv

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/usr/local/cargo/registry \
    uv pip install \
    "docling>=2.0.0" \
    "firecrawl-anydoc==0.1.7" \
    "pdf-inspector @ git+https://github.com/firecrawl/pdf-inspector.git@8b63ceb084f75dfd4425129d1d90d5bca45054e4"

# Stage 2: runner — the runtime system packages plus the prebuilt venv. This is
# what gets published; backend/Dockerfile starts FROM it.
FROM python:3.11-slim AS runner

ENV TZ=Asia/Taipei
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
ENV CUDA_LAUNCH_BLOCKING=1
ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/venv/bin:$PATH" \
    VIRTUAL_ENV=/opt/venv
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    ghostscript \
    libsndfile1 \
    libsm6 \
    libxext6 \
    mupdf-tools \
    qpdf \
    tesseract-ocr \
    tesseract-ocr-chi-tra \
    tzdata \
    wget \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
