# 複製此檔為 .env 並填入必要值即可啟動。
# 本專案所有服務統一使用同一份根目錄 .env（docker-compose.yml 的
# api / backend 服務皆以 env_file: ./.env 讀取，compose 本身的 ${VAR}
# 插值也讀這份檔案）——不再分成 backend/.env、brain/.env 多份維護。
# [required] = 必填，沒填會影響功能
# [optional] = 選填，有合理預設值

# ─── Compose 插值（host / build 層級）───
# 對外統一入口 port
PORT=8786
HTTPS_PORT=8787

# HuggingFace token (for private model repos)
HF_TOKEN=

# 選用服務開關：用逗號列出要啟用的 profile，compose 會自動讀取這個變數
# （不需要 --profile 參數）。可用值：vlm（本地視覺模型）、indextts（IndexTTS
# vLLM 語音合成）。都不需要就留空或整行註解掉。
# 範例：COMPOSE_PROFILES=vlm,indextts
# COMPOSE_PROFILES=

# Optional local VLM eyes service (啟用需在上面 COMPOSE_PROFILES 加 vlm)
VLM_IMAGE=vllm/vllm-openai:v0.11.0
VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct-FP8
VLM_SERVED_MODEL=openvman-vlm
VLM_MAX_MODEL_LEN=1024
VLM_MAX_NUM_SEQS=1
VLM_MAX_NUM_BATCHED_TOKENS=512
VLM_GPU_MEMORY_UTILIZATION=0.62

# Grafana admin 密碼（infra/grafana 服務用）
GRAFANA_PASSWORD=

# IndexTTS vLLM 服務（index-tts-vllm 容器用，啟用需在 COMPOSE_PROFILES 加 indextts）
# TORCH_CUDA_ARCH_LIST=8.9
# INDEXTTS_MODEL=IndexTeam/IndexTTS-1.5
# INDEXTTS_USE_MODELSCOPE=1
# INDEXTTS_DOWNLOAD_MODEL=1
# INDEXTTS_CONVERT_MODEL=1
# INDEXTTS_GPU_MEM=0.1

# ─── Backend (backend/app/config.py) ───
ENV=dev                                    # dev | prod
# BACKEND_PORT=8200                       # 預設 8200

# ─── IndexTTS (primary) ───
# TTS_INDEXTTS_URL=                       # 由 docker-compose 注入
TTS_INDEXTTS_DEFAULT_CHARACTER=hayley      # 預設語音角色

# ─── Edge-TTS (fallback, in-process) ───
# TTS_EDGE_ENABLED=true                   # 預設 true
# TTS_EDGE_VOICE=zh-TW-HsiaoChenNeural
# TTS_EDGE_SAMPLE_RATE=24000
# TTS_EDGE_MAX_TEXT_LENGTH=2000

# ─── AWS Polly (optional) ───
# TTS_AWS_ENABLED=false
# TTS_AWS_REGION=ap-northeast-1
# TTS_AWS_ACCESS_KEY_ID=
# TTS_AWS_SECRET_ACCESS_KEY=

# ─── GCP Cloud TTS (optional) ───
# TTS_GCP_ENABLED=false
# TTS_GCP_PROJECT_ID=
# TTS_GCP_CREDENTIALS_JSON=

# ─── Gemini TTS ───
TTS_GEMINI_URL=

# ─── Gateway ───
# MARKITDOWN_MAX_UPLOAD_BYTES=104857600    # 預設 100MB
CRAWLER_PROVIDER_URL=
# GATEWAY_CONVERT_TO_TRADITIONAL=true      # 預設 true，爬蟲/文件內容簡轉繁

# ─── Docling（文件解析，optional）───
# DOCLING_SERVE_URL=                       # 留空則不使用 Docling，走 MarkItDown
# DOCLING_TIMEOUT_MS=5000
# DOCLING_API_KEY=
# DOCLING_FALLBACK_TO_MARKITDOWN=true      # 預設 true，Docling 失敗時退回 MarkItDown

# ─── PDF Inspector / Repair（optional）───
# PDF_INSPECTOR_ENABLED=true               # 預設 true
# PDF_INSPECTOR_MIN_CONFIDENCE=0.85
# PDF_INSPECTOR_MIN_MARKDOWN_CHARS=10
# PDF_REPAIR_ENABLED=true                  # 預設 true
# PDF_REPAIR_TIMEOUT_MS=120000

# ─── Avatar（頭像/背景上傳，optional）───
# AVATAR_ASSETS_DIR=/data/avatar           # 由 docker-compose 注入
# AVATAR_BACKGROUNDS_DIR=/data/backgrounds # 由 docker-compose 注入
# AVATAR_MAX_UPLOAD_BYTES=104857600        # 預設 100MB
# AVATAR_BACKGROUND_MAX_UPLOAD_BYTES=26214400  # 預設 25MB

# ─── TTS Cache（optional）───
# TTS_CACHE_ENABLED=true                   # 預設 true
# TTS_CACHE_TTL_SECONDS=86400              # 預設 24 小時

# ─── Vision LLM ───
# For local VLM eyes, start `docker compose --profile vlm up -d vlm`
# and point these settings at the internal OpenAI-compatible endpoint.
# VISION_LLM_API_KEY=local-vlm
# VISION_LLM_BASE_URL=http://vlm:8000/v1
# VISION_LLM_MODEL=openvman-vlm

# ─── Whisper ───
# WHISPER_PROVIDER=openai
# WHISPER_API_KEY=

# ─── Brain (brain/api/config.py) ───
# === LLM 設定 ===
LLM_PROVIDER=gemini                    # [required] openai | gemini | azure | claude | vllm | groq
LLM_MODEL=gemini-3.1-flash-lite        # [required] 主要使用的模型
# LLM_FALLBACK_CHAIN=gemini:gemini-3.1-flash-lite,groq:llama-3.3-70b-versatile,openai:gpt-4o-mini
# LLM_DISABLE_MODEL_DISCOVERY=false    # 預設 false，關掉後 fallback chain 完全照上面寫的順序走
# LLM_REQUEST_TIMEOUT_SECONDS=20       # 單一 hop 的 HTTP 逾時（秒）

# === 備用 Provider Keys（填對應 LLM_PROVIDER 的那一個即可）===
GEMINI_API_KEY=                        # [required if provider=gemini] Google Gemini
GROQ_API_KEY=                          # [required if provider=groq]   Groq (Llama, Mixtral)
OPENAI_API_KEY=                        # [required if provider=openai] OpenAI (GPT-4o, GPT-4o-mini)
# VOYAGE_API_KEY=                      # [required if embedding=voyage] Voyage AI

# === Embedding 設定 ===
# EMBEDDING_ACTIVE_VERSION=bge         # [optional] bge | gemini | openai | voyage

# === Web Search ===
# GATEWAY_BASE_URL=http://backend:8200

# === Dreaming 設定（memory consolidation）===
# DREAMING_ENABLED=false                # [optional] 是否啟用背景記憶整合
# DREAMING_MIN_RECALL_COUNT=1

# === Auto Recall ===
# AUTO_RECALL_ENABLED=false

# === Privacy Filter 設定 ===
# PRIVACY_FILTER_EGRESS_ENABLED=true    # [optional] true | false — 是否掃描 LLM 回應（egress）
# PRIVACY_FILTER_DEVICE=cpu             # [optional] cpu | cuda — OPF 模型運算裝置
