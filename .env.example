# 複製此檔為 .env 並填入必要值即可啟動。
# 本專案所有服務統一使用同一份根目錄 .env（docker-compose.yml 的
# api / backend 服務皆以 env_file: ./.env 讀取，compose 本身的 ${VAR}
# 插值也讀這份檔案）——不再分成 backend/.env、brain/.env 多份維護。
# [required] = 必填，沒填會影響功能
# [optional] = 選填，有合理預設值

# ─── Compose 插值（host / build 層級）───
DOCKERHUB_USERNAME=tbdavid2019         # Public Docker Hub namespace
OPENVMAN_IMAGE_TAG=latest              # Watchtower-managed image tag
# Worktree 開發可取消下列設定，之後同樣使用 `docker compose up -d`。
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# COMPOSE_PROJECT_NAME=openvman-feature-x
# 對外統一入口 port
PORT=8786
HTTPS_PORT=8787

# 主機 nginx 公開 HTTPS（只在需要公開網域時必填）
PUBLIC_DOMAIN=
LETSENCRYPT_EMAIL=

# HuggingFace token (for private model repos)
HF_TOKEN=

# 選用服務開關：用逗號列出要啟用的 profile，compose 會自動讀取這個變數。
# 可用值：
#   - embedding : 本地 BGE-M3 向量嵌入模型（未設定外部 EMBEDDING_SERVICE_URL 時必須啟用）
#   - vlm       : 本地視覺模型（Qwen3-VL vLLM 容器）
#   - indextts  : 本地 IndexTTS 語音合成容器
# 全本地 GPU 模式範例：COMPOSE_PROFILES=embedding,vlm,indextts
# 共用外部 GPU 服務模式範例：留空，並填入下方 EMBEDDING_SERVICE_URL、VISION_LLM_BASE_URL、TTS_INDEXTTS_URL
COMPOSE_PROFILES=embedding,vlm

# ─── 共用 / 外部 GPU 服務（設定後優先使用外部服務，不需啟用對應本地 profile）───
# EMBEDDING_SERVICE_URL=http://shared-gpu-node:8009
# EMBEDDING_SERVICE_TOKEN=                 # 外部 embedding gateway 的 Bearer token；未填則沿用 GATEWAY_INTERNAL_TOKEN
# EMBEDDING_ALLOWED_ORIGINS=               # 選填，逗號分隔的明確瀏覽器 origins；留空表示不允許跨來源瀏覽器呼叫
# VISION_LLM_BASE_URL=http://shared-gpu-node:8000/v1
# TTS_INDEXTTS_URL=http://shared-gpu-node:8011

# Optional local VLM eyes service（啟用需在上面 COMPOSE_PROFILES 加 vlm）。
# Runtime defaults live in docker-compose.yml; only override these when testing
# a different model or GPU budget.
# VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct-FP8
# VLM_GPU_MEMORY_UTILIZATION=0.45

# Grafana admin 密碼（infra/grafana 服務用，必填且不得使用預設值）
GRAFANA_PASSWORD=                       # 至少 32 bytes 的唯一隨機值

# IndexTTS vLLM 服務（index-tts-vllm 容器用，啟用需在 COMPOSE_PROFILES 加 indextts）
# TORCH_CUDA_ARCH_LIST=8.9
# INDEXTTS_MODEL=IndexTeam/IndexTTS-1.5
# INDEXTTS_USE_MODELSCOPE=1
# INDEXTTS_DOWNLOAD_MODEL=1
# INDEXTTS_CONVERT_MODEL=1
# INDEXTTS_GPU_MEM=0.1

# ─── Backend (backend/app/config.py) ───
ENV=prod                                   # dev | prod；dev override 會強制使用 dev
# BACKEND_PORT=8200                       # 預設 8200
GATEWAY_INTERNAL_TOKEN=                  # 必填；Backend／Brain／IndexTTS 共用的高熵內部 token

# ─── 帳號與 session（SESSION_JWT_SECRET 必填）───
SESSION_JWT_SECRET=                       # 必須至少 32 bytes 的密碼學安全隨機值
AUTH_TEMPORARY_PASSWORD_SECRET=           # 選填，至少 32 bytes；未設時沿用 SESSION_JWT_SECRET。更換此值會使舊批次密碼無法解密。
AUTH_ROOT_USERNAME=                       # 唯一 ROOT 帳號名稱，留空為 ai360
# AUTH_DATABASE_PATH=/data/auth/accounts.db
# AUTH_COOKIE_SECURE=false                # 只有本機 HTTP dev 設 false；prod 強制 Secure
# AUTH_JWT_ISSUER=openvman
# AUTH_JWT_AUDIENCE=openvman-web
# AUTH_SESSION_LIFETIME_SECONDS=86400     # 預設 24 小時

# ─── IndexTTS (選用，預設停用；若指定 external URL 或啟動 indextts profile 才會啟用) ───
TTS_INDEXTTS_URL=
# TTS_ALLOWED_ORIGINS=                     # 選填，逗號分隔的明確 origins；留空表示不允許瀏覽器跨來源呼叫
# TTS_INDEXTTS_DEFAULT_CHARACTER=hayley      # 預設語音角色

# ─── Edge-TTS (fallback, in-process) ───
# TTS_EDGE_ENABLED=true                   # 預設 true
# TTS_EDGE_VOICE=zh-TW-HsiaoChenNeural
# TTS_EDGE_SAMPLE_RATE=24000
# TTS_EDGE_MAX_TEXT_LENGTH=2000

# ─── AWS Polly (optional) ───
# TTS_AWS_ENABLED=false
# TTS_AWS_REGION=ap-northeast-1
# TTS_AWS_ACCESS_KEY_ID=
# TTS_AWS_SECRET_ACCESS_KEY=

# ─── GCP Cloud TTS (optional) ───
# TTS_GCP_ENABLED=false
# TTS_GCP_PROJECT_ID=
# TTS_GCP_CREDENTIALS_JSON=

# ─── Gemini TTS ───
TTS_GEMINI_URL=

# ─── VoxCPM360 (選用；外部 GPU 節點的 CastAgent 相容 /api/v1/tts/*) ───
TTS_VOXCPM_URL=                          # 例：http://10.9.0.37:8800
# TTS_VOXCPM_API_KEY=                    # 對應上游 TTS_API_KEY；上游留空則不必填
# TTS_VOXCPM_DEFAULT_VOICE=voxcpm2-cosy-young-female-01
# VoxCPM diffusion 去噪步數。延遲與步數幾乎線性（實測 31 字：10 步 3.2 秒、
# 30 步 8.0 秒），串流的首音延遲則幾乎不受影響。部署預設 10。
# TTS_VOXCPM_INFERENCE_TIMESTEPS=10
# TTS_VOXCPM_EXCLUDED_VOICES=barbet-hung-yi-lee   # 逗號分隔，不想出現在選單裡的 voice_id

# ─── CosyVoice3 (選用；臺灣台語，CastAgent 相容 /v1/*) ───
TTS_COSYVOICE_URL=                       # 例：http://10.9.0.35:50010/v1
# TTS_COSYVOICE_API_KEY=                 # 上游需要 Bearer token；上游留空則不必填
# TTS_COSYVOICE_DEFAULT_VOICE=young-male-02
# TTS_COSYVOICE_EXCLUDED_VOICES=         # 逗號分隔，不想出現在選單裡的 voice_id

# ─── Gateway ───
# DOCUMENT_MAX_UPLOAD_BYTES=104857600      # 預設 100MB
CRAWLER_PROVIDER_URL=
# GATEWAY_CONVERT_TO_TRADITIONAL=true      # 預設 true，爬蟲/文件內容簡轉繁

# ─── Docling（文件解析，optional）───
# DOCLING_SERVE_URL=                       # 舊版健康探測設定；轉檔使用 container 內的 Docling
# DOCLING_TIMEOUT_MS=5000
# DOCLING_API_KEY=
# DOCLING_FALLBACK_TO_ANYDOC=true          # 預設 true，Docling 失敗時退回 AnyDoc

# ─── PDF Inspector / Repair（optional）───
# PDF_INSPECTOR_ENABLED=true               # 預設 true
# PDF_INSPECTOR_MIN_CONFIDENCE=0.85
# PDF_INSPECTOR_MIN_MARKDOWN_CHARS=10
# PDF_REPAIR_ENABLED=true                  # 預設 true
# PDF_REPAIR_TIMEOUT_MS=120000

# ─── Avatar（頭像/背景上傳，optional）───
# AVATAR_ASSETS_DIR=/data/avatar           # 由 docker-compose 注入
# AVATAR_BACKGROUNDS_DIR=/data/backgrounds # 由 docker-compose 注入
# AVATAR_MAX_UPLOAD_BYTES=104857600        # 預設 100MB
# AVATAR_BACKGROUND_MAX_UPLOAD_BYTES=26214400  # 預設 25MB

# ─── TTS Cache（optional）───
# TTS_CACHE_ENABLED=true                   # 預設 true
# TTS_CACHE_TTL_SECONDS=86400              # 預設 24 小時

# ─── Vision LLM ───
# For local VLM eyes, start `docker compose --profile vlm up -d vlm`
# and point these settings at the internal OpenAI-compatible endpoint.
# VISION_LLM_API_KEY=                    # 外部 VLM 的 API Key；本機 VLM 留空並沿用 GATEWAY_INTERNAL_TOKEN
# VISION_LLM_BASE_URL=http://vlm:8000/v1
# VISION_LLM_MODEL=openvman-vlm

# ─── Whisper ───
# 語音轉文字。都是整檔上傳、無串流端點：使用者講完才開始算延遲。
# 我們要的是華語逐字稿，所以輸出華語的排前面。同一段 5.12s 臺語語音實測：
#   breeze     = Breeze-ASR-26（聯發科）1.50s，臺語轉寫成華語，建議預設。
#   xiaomi     = Xiaomi-CocktailASR-1 1.62s，臺語轉華語但輸出簡體（已自動轉繁）。
#                目標語者模型，我們把同一個音檔同時當 target 與 ref 送出。
#   sensevoice = SenseVoice-Small（阿里）0.83s，保留臺語用字，僅作備援。
# ASR_PROVIDER=breeze              # breeze | xiaomi | sensevoice | openai
#                                  # 舊名 WHISPER_PROVIDER 仍可用
# WHISPER_API_KEY=
# ASR_BREEZE_URL=http://10.9.0.37:8801
# ASR_XIAOMI_URL=http://10.9.0.19:8802
# ASR_SENSEVOICE_URL=http://10.9.0.37:50002

# ─── Brain (brain/api/config.py) ───
# === LLM 設定 ===
LLM_PROVIDER=gemini                    # [required] openai | gemini | azure | claude | vllm | groq | nen
LLM_MODEL=gemini-3.1-flash-lite        # [required] 主要使用的模型
# LLM_FALLBACK_CHAIN=gemini:gemini-3.1-flash-lite,groq:llama-3.3-70b-versatile,nen:gemini-3.5-flash-lite
# LLM_DISABLE_MODEL_DISCOVERY=false    # 預設 false，關掉後 fallback chain 完全照上面寫的順序走
# LLM_REQUEST_TIMEOUT_SECONDS=20       # 單一 hop 的 HTTP 逾時（秒）
# LLM_STREAM_INCLUDE_USAGE=true        # 串流完成時要求 provider 回傳 token usage

# === Provider 連線設定（主 provider 與 fallback chain 內出現者都必須填）===
GEMINI_API_KEY=                        # Google Gemini
GROQ_API_KEY=                          # Groq (Llama, Mixtral)
NEN_API_KEY=                           # NEN OpenAI-compatible API
NEN_BASE_URL=https://nen.com.tw/v1
OPENAI_API_KEY=                        # OpenAI (GPT-4o, GPT-4o-mini)
# VOYAGE_API_KEY=                      # [required if embedding=voyage] Voyage AI

# === Embedding 設定 ===
# EMBEDDING_ACTIVE_VERSION=bge         # [optional] bge | gemini | openai | voyage
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# EMBEDDING_EXPECTED_DIMENSION=1024
# EMBEDDING_WRITE_IDENTITY=             # 完整 7 段 canonical identity；空白時依 active version 推導
# EMBEDDING_IDENTITY_ALIASES=            # JSON object；明確將舊 alias 對應到 document identity
# EMBEDDING_COMPATIBLE_LEGACY_IDENTITIES= # JSON array；只填已經 parity 驗證的舊完整 identity
# EMBEDDING_PROVIDER_FALLBACKS=bge,gemini,openai,voyage
# EMBEDDING_PROVIDER_TIMEOUT=30
# EMBEDDING_GEMINI_MODEL=gemini-embedding-001
# EMBEDDING_GEMINI_DIMENSIONS=768
# EMBEDDING_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# EMBEDDING_OPENAI_MODEL=text-embedding-3-small
# EMBEDDING_OPENAI_DIMENSIONS=1536
# EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDING_VOYAGE_MODEL=voyage-3-large
# EMBEDDING_VOYAGE_DIMENSIONS=1024
# EMBEDDING_VOYAGE_BASE_URL=https://api.voyageai.com/v1

# === Web Search ===
# URL2MD_BASE_URLS=                       # optional complete comma-separated override; default order is TWO_MD_BASE_URLS
# URL2MD_PRIMARY_URL=https://2md.aiurl.tw
# URL2MD_FALLBACK_URLS=https://2md.glsoft.ai,https://create360.ai
# URL2MD_SEARCH_ENABLED=true
# URL2MD_READ_ENABLED=true
# WEB_SEARCH_MAX_RESULTS=8
# WEB_SEARCH_MIN_RELEVANCE=0.15         # 網路結果對原句的最低相關度（embedding 餘弦），0 為關閉重排
# WEB_SEARCH_RELEVANCE_RATIO=0.7        # 只保留相關度不低於最佳結果 70% 的網頁
# WEB_SEARCH_BLOCKED_DOMAINS=           # 逗號分隔的網域黑名單，例如 zh.wikipedia.org
# WEB_READ_MAX_URLS=5                   # read_web_page 一次最多幾個網址（走 2md /v1/batch 併成單一請求）
# URL2MD_MAX_ATTEMPTS=3
# URL2MD_TOTAL_BUDGET_S=20              # search/read 整條 fallback 鏈共用的總秒數
# URL2MD_RETRY_BASE_DELAY_S=0.25        # full-jitter fallback delay 起點
# URL2MD_RETRY_MAX_DELAY_S=2.0
# URL2MD_CIRCUIT_COOLDOWN_S=60
# URL2MD_COORDINATION_ENABLED=true
# URL2MD_COORDINATION_REDIS_URL=        # 空白時沿用 REDIS_URL；Redis 不可用時降級為 process-local
# URL2MD_COORDINATION_NAMESPACE=brain:url2md
# URL2MD_HALF_OPEN_LEASE_S=5
#
# 回覆深度模式由請求的 mode 欄位決定（fast / standard / deep），預設 standard。
# 各模式的輪次與筆數寫在 brain/api/core/reply_modes.py，上面這些設定是它們的預設底值。
# WIKI_API_BASE_URL=https://wiki.david888.com/api
# WIKI_PUBLISH_ENABLED=true
# WIKI_PUBLISH_MAX_CHARS=100000

# === Agent 設定 ===
# AGENT_LOOP_MAX_ROUNDS=6                # 工具輪次上限
# CHAT_FORCE_KNOWLEDGE_SEARCH=true       # 一般使用者回合第一次呼叫強制走 search_knowledge，不讓模型憑記憶作答
# CHAT_ANSWER_PASS_EXCLUDES_KNOWLEDGE_SEARCH=true  # 查完知識庫後的回合拿掉 search_knowledge，其他工具（search_web 等）照常
# CHAT_MAX_FOLLOWUP_TOOL_ROUNDS=1        # 第一輪平行查完後最多再追加幾輪工具，之後只能作答（最多 2+N 次 LLM 呼叫）
# KNOWLEDGE_SEARCH_MERGE_LIMIT=5         # 多條查詢 RRF 融合後最多保留幾個片段給模型
# FORCED_TOOL_MODEL_OVERRIDE=            # 強制工具呼叫改用較快的小模型，例如 gemini-2.0-flash-lite
# FORCED_TOOL_MAX_TOKENS=400                # 第一輪可能一次呼叫多個工具，給足 token

# === Dreaming 設定（memory consolidation）===
# DREAMING_ENABLED=false                # [optional] 是否啟用背景記憶整合
# DREAMING_TIMEZONE=Asia/Taipei          # 排程、每日防重與每日記憶／報告共用的時區
# DREAMING_MIN_RECALL_COUNT=1

# === Auto Recall ===
# AUTO_RECALL_ENABLED=false

# === Privacy Filter 設定 ===
# PRIVACY_FILTER_EGRESS_ENABLED=true    # [optional] true | false — 是否掃描 LLM 回應（egress）
# PRIVACY_FILTER_DEVICE=cpu             # [optional] cpu | cuda — OPF 模型運算裝置

# === 888a2a-lite Agent-to-Agent Network ===
# A2A_ENABLED=false                      # [optional] 是否啟用 A2A 背景橋接守護行程
# A2A_HUB_URL=https://a2a.david888.com   # [optional] 888a2a Hub 伺服器網址
# A2A_HUB_KEY=                           # [required for private circle] 只在註冊時送出的 secret；不可硬編碼
# A2A_ALLOW_PUBLIC_CIRCLE=false           # 明確 opt-in 才允許無 key 加入 public circle
# A2A_DISPLAY_NAME=openVman              # [optional] 在 A2A 網絡上的公開顯示名稱
# A2A_CREDENTIALS_PATH=/data/a2a/credentials.json # [optional] 本地憑證持久化路徑
# A2A_CREDENTIALS_ENCRYPTION_KEY=        # [optional] 憑證靜態加密金鑰（Fernet 32-bytes base64），未設定時沿用 SESSION_JWT_SECRET
# A2A_DEFAULT_PROJECT_ID=default         # [optional] A2A 任務預設 project ID
# A2A_DEFAULT_PERSONA_ID=                # [optional] A2A 任務預設回覆的角色 Persona ID（留空使用系統預設）
# A2A_QUEUE_DB_PATH=/data/a2a/work.db    # [optional] A2A 佇列 SQLite WAL 資料庫路徑
# A2A_QUEUE_RETENTION_DAYS=30            # [optional] terminal inbox/outbound record retention
# A2A_LEADER_LEASE_TTL_SECONDS=30        # [optional] Redis 單例領導者租約秒數
# A2A_ALLOW_GROUP_BROADCAST=false        # [optional] 明確 opt-in 才允許 Brain 發送群組廣播
# A2A_MAX_CONCURRENCY=4                  # [optional] Hub task worker 上限
# A2A_MAX_TASKS_PER_MINUTE=60            # [optional] outbound task/group rate limit
# A2A_MAX_DELEGATION_HOPS=3              # [optional] 防止 agent delegation loop
