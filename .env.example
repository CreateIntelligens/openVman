# 複製此檔為 .env 並填入必要值即可啟動。
# 本專案所有服務統一使用同一份根目錄 .env（docker-compose.yml 的
# api / backend 服務皆以 env_file: ./.env 讀取，compose 本身的 ${VAR}
# 插值也讀這份檔案）——不再分成 backend/.env、brain/.env 多份維護。
# [required] = 必填，沒填會影響功能
# [optional] = 選填，有合理預設值

# ─── Compose 插值（host / build 層級）───
DOCKERHUB_USERNAME=tbdavid2019         # Public Docker Hub namespace
OPENVMAN_IMAGE_TAG=latest              # Watchtower-managed image tag
# Worktree 開發可取消下列設定，之後同樣使用 `docker compose up -d`。
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# COMPOSE_PROJECT_NAME=openvman-feature-x
# 對外統一入口 port
PORT=8786
HTTPS_PORT=8787

# 主機 nginx 公開 HTTPS（只在需要公開網域時必填）
PUBLIC_DOMAIN=
LETSENCRYPT_EMAIL=

# HuggingFace token (for private model repos)
HF_TOKEN=

# 選用服務開關：用逗號列出要啟用的 profile，compose 會自動讀取這個變數。
# 可用值：
#   - embedding : 本地 EmbeddingGemma 2 向量嵌入模型（未設定外部 EMBEDDING_SERVICE_URL 時必須啟用）
#   - vlm       : 本地視覺模型（Qwen3-VL vLLM 容器）
# 全本地 GPU 模式範例：COMPOSE_PROFILES=embedding,vlm
# 共用外部 GPU 服務模式範例：留空，並填入下方 EMBEDDING_SERVICE_URL、VISION_LLM_BASE_URL、TTS_INDEXTTS_URL
COMPOSE_PROFILES=embedding,vlm

# ─── 共用 / 外部 GPU 服務（設定後優先使用外部服務，不需啟用對應本地 profile）───
# EMBEDDING_SERVICE_URL=http://shared-gpu-node:8009
# EMBEDDING_SERVICE_TOKEN=                 # 外部 embedding gateway 的 Bearer token；未填則沿用 GATEWAY_INTERNAL_TOKEN
# VISION_LLM_BASE_URL=http://shared-gpu-node:8000/v1
# TTS_INDEXTTS_URL=http://shared-gpu-node:8011

# Optional local VLM eyes service（啟用需在上面 COMPOSE_PROFILES 加 vlm）。
# Runtime defaults live in docker-compose.yml; only override these when testing
# a different model or GPU budget.
# VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct-FP8
# VLM_GPU_MEMORY_UTILIZATION=0.45

# Grafana admin 密碼（infra/grafana 服務用，必填且不得使用預設值）
GRAFANA_PASSWORD=                       # 至少 32 bytes 的唯一隨機值

# ─── Backend (backend/app/config.py) ───
ENV=prod                                   # dev | prod；dev override 會強制使用 dev
# BACKEND_PORT=8200                       # 預設 8200
GATEWAY_INTERNAL_TOKEN=                  # 必填；Backend／Brain／IndexTTS 共用的高熵內部 token

# ─── 帳號與 session（SESSION_JWT_SECRET 必填）───
SESSION_JWT_SECRET=                       # 必須至少 32 bytes 的密碼學安全隨機值
AUTH_TEMPORARY_PASSWORD_SECRET=           # 選填，至少 32 bytes；未設時沿用 SESSION_JWT_SECRET。更換此值會使舊批次密碼無法解密。
MODEL_PROVIDER_ENCRYPTION_SECRET=      # 必填；至少 32 bytes，用於加密後台「模型供應商」頁設定的 API key
AUTH_ROOT_USERNAME=                       # 唯一 ROOT 帳號名稱，留空為 ai360
# AUTH_DATABASE_PATH=/data/auth/accounts.db
# AUTH_COOKIE_SECURE=false                # 只有本機 HTTP dev 設 false；prod 強制 Secure
# AUTH_JWT_ISSUER=openvman
# AUTH_JWT_AUDIENCE=openvman-web
# AUTH_SESSION_LIFETIME_SECONDS=86400     # 預設 24 小時
# CORS_ALLOWED_ORIGINS=                   # 允許哪些網站的瀏覽器前端直接帶 API key 呼叫：https://a.example,https://b.example 或 *；留空不開放（Embed key 另有自己的網域白名單）
# API_KEY_RATE_LIMIT_PER_MINUTE=300       # 每把帳號 API key 每分鐘上限，超過回 429；0 不限

# ─── IndexTTS (選用，預設停用；填入外部 IndexTTS 服務網址才會啟用) ───
TTS_INDEXTTS_URL=
# TTS_ALLOWED_ORIGINS=                     # 選填，逗號分隔的明確 origins；留空表示不允許瀏覽器跨來源呼叫
# TTS_INDEXTTS_DEFAULT_CHARACTER=hayley      # 預設語音角色
# TTS_TAIWANESE_FALLBACK_ORDER=cosyvoice,voxcpm,indextts  # 台語那一輪的引擎順序（專案順位優先）；全部失敗才退 Edge
# 第二台 IndexTTS（nurse24h）：獨立引擎 indextts-nurse，帳號／專案選了才用，不當備援；留空不列出
# TTS_INDEXTTS_NURSE_URL=http://nurse-tts.example:8001
# TTS_INDEXTTS_NURSE_DEFAULT_CHARACTER=hayley   # 沒指定聲音時用的角色

# ─── Edge-TTS (fallback, in-process) ───
# TTS_EDGE_ENABLED=true                   # 預設 true
# TTS_EDGE_VOICE=zh-TW-HsiaoChenNeural
# TTS_EDGE_SAMPLE_RATE=24000
# TTS_EDGE_MAX_TEXT_LENGTH=2000
# TTS_EDGE_PROBE_INTERVAL_SECONDS=1800    # 定時試念一句，壞了在 /healthz 與 vman_edge_tts_up 看得到；0 不檢查

# ─── AWS Polly (optional) ───
# TTS_AWS_ENABLED=false
# TTS_AWS_REGION=ap-northeast-1
# TTS_AWS_ACCESS_KEY_ID=
# TTS_AWS_SECRET_ACCESS_KEY=

# ─── GCP Cloud TTS (optional) ───
# TTS_GCP_ENABLED=false
# TTS_GCP_PROJECT_ID=
# TTS_GCP_CREDENTIALS_JSON=

# ─── Gemini TTS ───
TTS_GEMINI_URL=
# 專案綁定 Gemini key 時直接使用 Google TTS；共用專案維持 Console。
TTS_GEMINI_MODEL=gemini-3.8-flash-tts

# ─── VoxCPM360 (選用；外部 GPU 節點的 CastAgent 相容 /api/v1/tts/*) ───
TTS_VOXCPM_URL=                          # 例：http://10.9.0.37:8800
# TTS_VOXCPM_API_KEY=                    # 對應上游 TTS_API_KEY；上游留空則不必填
# TTS_VOXCPM_DEFAULT_VOICE=voxcpm2-cosy-young-female-02  # 預設 Hayley，與 IndexTTS hayley、CosyVoice young-female-02 同一位
# VoxCPM diffusion 去噪步數。延遲與步數幾乎線性（實測 31 字：10 步 3.2 秒、
# 30 步 8.0 秒），串流的首音延遲則幾乎不受影響。部署預設 10。
# TTS_VOXCPM_INFERENCE_TIMESTEPS=10
# TTS_VOXCPM_EXCLUDED_VOICES=star-chen-xiaoming   # 逗號分隔，不想出現在選單裡的 voice_id；已登錄的會在啟動同步時連同授權一起刪除

# ─── CosyVoice3 (選用；臺灣台語，CastAgent 相容 /v1/*) ───
TTS_COSYVOICE_URL=                       # 例：http://10.9.0.35:50010/v1
# TTS_HANJI_CONVERT_URL=                 # 預設從 TTS_COSYVOICE_URL 推導 /api/convert；詞表另設服務時才填完整網址
# TTS_HANJI_CONVERT_ENABLED=false        # 停用詞表串接；預設 true
TTS_VOXCPM_HANJI_VERSION=v6
TTS_COSYVOICE_HANJI_VERSION=v1
# TTS_COSYVOICE_API_KEY=                 # 上游需要 Bearer token；上游留空則不必填
# TTS_COSYVOICE_DEFAULT_VOICE=young-female-02   # Hayley
# TTS_COSYVOICE_EXCLUDED_VOICES=         # 逗號分隔，不想出現在選單裡的 voice_id

# >>> TTS 逾時、鏈期限與斷路器（全部選填；預設與理由見 docs/specs/01_BACKEND_SPEC.md 6.4）
# 每站預算 = base + 每字 × 字數，封頂 max；鏈期限 = 每站預算 × factor（封頂 chain max）＋Edge 尾段
# TTS_CONNECT_TIMEOUT_SECONDS=2
# TTS_NODE_BASE_SECONDS=10
# TTS_NODE_PER_CHAR_SECONDS=0.1
# TTS_NODE_MAX_SECONDS=120
# TTS_VOXCPM_MODEL_LOAD_SECONDS=45       # 後台試聽指定 VoxCPM model_id 時多給的重載時間
# TTS_HANJI_TIMEOUT_SECONDS=0.8          # 台語詞表查詢上限；查不到這一站失敗、換下一家
# TTS_STREAM_FIRST_BYTE_SECONDS=10       # 串流 header＋第一段聲音的上限，逾時換引擎
# TTS_STREAM_STALL_SECONDS=10            # 聲音開始後兩段之間的最長停頓，逾時把串流收尾
# TTS_EDGE_BASE_SECONDS=8                # 保留給最後 Edge 的尾段
# TTS_EDGE_PER_CHAR_SECONDS=0.03
# TTS_CHAIN_FACTOR=1.5
# TTS_CHAIN_MAX_SECONDS=150
# UPSTREAM_BREAKER_FAILURES=2            # TTS 與批次 ASR 共用：逾時／5xx 連續幾次冷卻（連不上立刻冷卻）
# UPSTREAM_BREAKER_COOLDOWN_SECONDS=60
# UPSTREAM_PROBE_INTERVAL_SECONDS=10     # 背景健康探測週期（TTS 與批次 ASR 節點）；0 不探測
# UPSTREAM_PROBE_TIMEOUT_SECONDS=1.5
# BRAIN_PROXY_CONNECT_TIMEOUT_SECONDS=2
# BRAIN_PROXY_READ_TIMEOUT_SECONDS=120   # 兩個 chunk 之間的上限，LLM 跑工具時會停很久
# <<< TTS 逾時、鏈期限與斷路器

# ─── Gateway ───
# DOCUMENT_MAX_UPLOAD_BYTES=104857600      # 知識文件／文件轉換每檔上限，預設 100MB
# DOCUMENT_ZIP_MAX_UNCOMPRESSED_BYTES=524288000  # docx/pptx/xlsx 解壓後總量上限，預設 500MB
# DOCUMENT_ZIP_MAX_ENTRIES=10000           # docx/pptx/xlsx 內含檔案數上限
# GATEWAY_MAX_FILE_SIZE_MB=100             # /api/v1/uploads 每檔上限（MB）
# GATEWAY_VIDEO_MAX_DURATION_SECONDS=120   # /api/v1/uploads 影片長度上限
# GATEWAY_VIDEO_MAX_FRAMES=60              # 影片最多送幾張影格給 VLM
# ASR_MAX_UPLOAD_BYTES=26214400            # 語音轉寫／試辨識上限，預設 25MB
# ASR_MAX_DURATION_SECONDS=300             # 語音長度上限，預設 5 分鐘
# VISION_FRAME_MAX_BYTES=10485760          # /api/v1/vision/describe 單張影格上限，預設 10MB
# UPLOAD_IMAGE_MAX_SIDE_PX=8192            # 所有圖片上傳的最長邊上限
# BRAIN_PROXY_MAX_BODY_BYTES=115343360     # 轉發給 Brain 的請求本體上限，預設 110MB
CRAWLER_PROVIDER_URL=
# GATEWAY_CONVERT_TO_TRADITIONAL=true      # 預設 true，爬蟲/文件內容簡轉繁

# ─── Docling（文件解析，optional）───
# DOCLING_SERVE_URL=                       # 舊版健康探測設定；轉檔使用 container 內的 Docling
# DOCLING_TIMEOUT_MS=5000
# DOCLING_API_KEY=
# DOCLING_FALLBACK_TO_ANYDOC=true          # 預設 true，Docling 失敗時退回 AnyDoc

# ─── PDF Inspector / Repair（optional）───
# PDF_INSPECTOR_ENABLED=true               # 預設 true
# PDF_INSPECTOR_MIN_CONFIDENCE=0.85
# PDF_INSPECTOR_MIN_MARKDOWN_CHARS=10
# PDF_REPAIR_ENABLED=true                  # 預設 true
# PDF_REPAIR_TIMEOUT_MS=120000

# ─── Avatar（頭像/背景上傳，optional）───
# AVATAR_ASSETS_DIR=/data/avatar           # 由 docker-compose 注入
# AVATAR_BACKGROUNDS_DIR=/data/backgrounds # 由 docker-compose 注入
# AVATAR_MAX_UPLOAD_BYTES=104857600        # 預設 100MB
# AVATAR_BACKGROUND_MAX_UPLOAD_BYTES=26214400  # 預設 25MB
# AVATAR_JOBS_DIR=/data/avatar-jobs        # 影片轉素材包的工作目錄，由 docker-compose 注入
# AVATAR_SOURCE_MAX_UPLOAD_BYTES=209715200 # 影片轉素材包的來源影片上限，預設 200MB
# AVATAR_SOURCE_MAX_DURATION_SECONDS=60    # 來源影片長度上限
# AVATAR_SOURCE_IMAGE_MAX_UPLOAD_BYTES=26214400  # 影片轉素材包改用靜態人像圖片時的上限，預設 25MB
# 素材包加密金鑰 AVATAR_BUNDLE_KEY 不在這裡，放 avatar-pipeline/.env（見 avatar-pipeline/.env.example）

# ─── TTS Cache（optional）───
# TTS_CACHE_ENABLED=true                   # 預設 true
# TTS_CACHE_TTL_SECONDS=86400              # 預設 24 小時

# ─── Vision LLM ───
# For local VLM eyes, start `docker compose --profile vlm up -d vlm`
# and point these settings at the internal OpenAI-compatible endpoint.
# VISION_LLM_API_KEY=                    # 外部 VLM 的 API Key；本機 VLM 留空並沿用 GATEWAY_INTERNAL_TOKEN
# VISION_LLM_BASE_URL=http://vlm:8000/v1
# VISION_LLM_MODEL=openvman-vlm

# ─── 鏡頭判讀（Clef）───
# 攝影機每秒一幀，每個視覺事件問 Clef 一題是非題；失敗時才改問上面的 VLM。留空只用 VLM。
# 金鑰沿用 CLEF_API_KEY（自架端點不需要）。
# VISION_CLEF_URL=https://clef.create360.ai/v1/systemone
# VISION_CLEF_MODEL=clef-flash
# VISION_CLEF_TIMEOUT_SECONDS=5

# ─── Whisper ───
# 語音轉文字。都是整檔上傳、無串流端點：使用者講完才開始算延遲。
# 我們要的是華語逐字稿，所以輸出華語的排前面。同一段 5.12s 臺語語音實測：
#   breeze     = Breeze-ASR-26（聯發科）1.50s，臺語轉寫成華語，建議預設。
#   sensevoice = SenseVoice-Small（阿里）0.83s，保留臺語用字，僅作備援。
# ASR_PROVIDER=breeze              # breeze | r2t2 | r2t2-dev | sensevoice | openai
#                                  # 沒自己選引擎的人都用這個；後台沒有全站預設可以蓋過它
#                                  # 舊名 WHISPER_PROVIDER 仍可用
# WHISPER_API_KEY=                # openai 引擎的 key；設了之後它也會進所有專案的備援鏈（本地引擎全掛時才用）
# ASR_OPENAI_MODEL=gpt-4o-mini-transcribe  # 不指定語言自動判斷；中文出繁體、西語不會被改寫成中文
# Gemini 串流辨識（前台引擎 gemini-live，經 /api/v1/asr/stream；用 GEMINI_API_KEY，需在帳號頁授權）
# ASR_GEMINI_STREAM_MODEL=gemini-3.5-transcribe-live
# ASR_GEMINI_STREAM_LANGUAGES=zh-TW,en-US,es-ES  # 只在前台沒帶專案時用；有專案時依該專案的語言分流產生（zh→zh-TW、en→en-US、es→es-ES、ja→ja-JP、ko→ko-KR）
# R2T2 串流辨識：r2t2-live 與批次 r2t2 分開授權；接 .35（2026-10-05 起為主機，對外是 asr.5gao.ai）。
# ASR_R2T2_URL=http://10.9.0.35:8040   # 批次 r2t2（/transcribe，帶專案詞表）；沒填就不排進備援順序
# ASR_R2T2_STREAM_URL=                    # 預設從 ASR_R2T2_URL 推導 ws(s)://…/asr_stream_api_v1；分開部署才覆寫
# ASR_R2T2_SECRET_KEY=            # 向服務管理者取得；網址或金鑰未設定回 not_configured
# R2T2 dev（.37 GB10）：獨立引擎 r2t2-dev／r2t2-dev-live，帳號選了才用，不當備援
# ASR_R2T2_DEV_URL=http://10.9.0.37:8803
# ASR_R2T2_DEV_STREAM_URL=                # 預設從 ASR_R2T2_DEV_URL 推導；分開部署才覆寫
# ASR_R2T2_DEV_SECRET_KEY=
# ASR_R2T2_DEV_TIMEOUT_SECONDS=20   # 批次只等這麼久，等不到交給下一家引擎
# ASR_FINAL_JUDGE_LOG=                  # 串流定稿與暫定字幕不同時的判斷紀錄，預設 backend/logs/asr_final_judge.jsonl
# ASR_OPENAI_BASE_URL=             # 空字串走 OpenAI 官方端點（以前誤用 VISION_LLM_BASE_URL）
# ASR_BREEZE_URL=http://10.9.0.37:8801
# ASR_SENSEVOICE_URL=http://10.9.0.37:50002
# ASR_LANGUAGE_CHECK_TIMEOUT_SECONDS=2.5  # 台語分流時「是不是台語」判斷的等待上限；逾時當不是台語，照原本的 TTS
# >>> 批次 ASR 逾時與鏈期限（全部選填；預設與理由見 docs/specs/01_BACKEND_SPEC.md 6.4）
# 每站預算 = base + 每秒音訊 × 音訊秒數，封頂 max；鏈期限 = 每站預算 × factor（封頂 chain max）
# ASR_CONNECT_TIMEOUT_SECONDS=2
# ASR_NODE_BASE_SECONDS=8
# ASR_NODE_PER_AUDIO_SECOND=0.5
# ASR_NODE_MAX_SECONDS=120
# ASR_CHAIN_FACTOR=1.5
# ASR_CHAIN_MAX_SECONDS=180              # 前端批次辨識的保險時間是這個再加 5 秒
# ASR_FFMPEG_BASE_SECONDS=15             # webm 等轉 wav 的上限 = base + 每秒音訊 × 秒數
# ASR_FFMPEG_PER_AUDIO_SECOND=0.2
# <<< 批次 ASR 逾時與鏈期限

# ─── Brain (brain/api/config.py) ───
# DEFAULT_PROJECT_ID=default            # 沒帶 project_id 的請求落在哪個專案；"default" 是它的保留別名，Brain 與 Backend 都讀這個值
# KNOWLEDGE_UPLOAD_MAX_BYTES=104857600  # Brain 端知識文件／raw 上傳每檔上限，預設 100MB
# QA_IMAGE_MAX_BYTES=10485760           # QA 圖片上限，預設 10MB
# QA_IMAGE_MAX_SIDE_PX=8192             # QA 圖片最長邊
# === LLM 設定 ===
LLM_PROVIDER=gemini                    # [required] openai | gemini | azure | claude | vllm | groq
LLM_MODEL=gemini-3.5-flash-lite        # [required] 主要使用的模型
# LLM_FALLBACK_CHAIN=gemini:gemini-3.5-flash-lite,openai:gpt-4.1-mini,groq:openai/gpt-oss-120b  # groq 的 llama-3.3-70b-versatile 已下架
# LLM_DISABLE_MODEL_DISCOVERY=false    # 預設 false，關掉後 fallback chain 完全照上面寫的順序走
# LLM_REQUEST_TIMEOUT_SECONDS=20       # 單一 hop 串流整段的牆鐘上限（秒）
# --- Brain 回答路徑逾時（詳見 brain/README.md「回答路徑逾時」）---
# LLM_CONNECT_TIMEOUT_SECONDS=3        # 每站連線上限
# LLM_FIRST_TOKEN_TIMEOUT_SECONDS=7    # 串流第一個字／兩段之間的上限，逾時換下一站
# LLM_NONSTREAM_TIMEOUT_SECONDS=10     # 回合內非串流呼叫的整段上限
# LLM_FIRST_TOKEN_BUDGET_SECONDS=15    # 一次 LLM 呼叫跨所有站等第一個字的總預算
# CHAT_TURN_BUDGET_SECONDS=30          # 整輪（含工具回合）預算，用完就拿現有結果作答
# KNOWLEDGE_SEARCH_TIMEOUT_SECONDS=6   # 知識庫查詢（含先查），逾時這輪不帶知識庫
# KNOWLEDGE_GRAPH_TIMEOUT_SECONDS=1    # 圖譜鄰居擴展，逾時回傳已取得的部分
# EMBEDDING_QUERY_TIMEOUT_SECONDS=2    # 查詢用 embedding（建索引照舊 30 秒）
# EMBEDDING_QUERY_MAX_RETRIES=1
# LLM_STREAM_INCLUDE_USAGE=true        # 串流完成時要求 provider 回傳 token usage

# === Provider 連線設定（主 provider 與 fallback chain 內出現者都必須填）===
GEMINI_API_KEY=                        # Google Gemini
GROQ_API_KEY=                          # Groq (Llama, Mixtral)
OPENAI_API_KEY=                        # OpenAI chat/ASR fallback and Decisions API
CLEF_API_KEY=                          # Clef (optional; shared by primary and backup endpoints)

# === Embedding 設定 ===
# 模型、revision、批次大小等預設值寫在程式裡（Brain：brain/api/config.py；gateway：brain/embedding/app.py），這裡只列會調整的。
# EMBEDDING_THRESHOLDS=                # JSON，依版本覆寫向量門檻（cosine 相似度），例如 {"gemma": {"retrieval": 0.68}}

# === Web Search ===
# URL2MD_BASE_URLS=                       # optional complete comma-separated override; default order is TWO_MD_BASE_URLS
# URL2MD_PRIMARY_URL=https://2md.aiurl.tw
# URL2MD_FALLBACK_URLS=https://2md.glsoft.ai,https://create360.ai
# URL2MD_SEARCH_ENABLED=true
# URL2MD_READ_ENABLED=true
# WEB_SEARCH_MAX_RESULTS=8
# WEB_SEARCH_BLOCKED_DOMAINS=           # 逗號分隔的網域黑名單，例如 zh.wikipedia.org
# WEB_READ_MAX_URLS=5                   # read_web_page 一次最多幾個網址（走 2md /v1/batch 併成單一請求）
# URL2MD_MAX_ATTEMPTS=3
# URL2MD_TOTAL_BUDGET_S=20              # search/read 整條 fallback 鏈共用的總秒數
# URL2MD_RETRY_BASE_DELAY_S=0.25        # full-jitter fallback delay 起點
# URL2MD_RETRY_MAX_DELAY_S=2.0
# URL2MD_CIRCUIT_COOLDOWN_S=60
# URL2MD_COORDINATION_ENABLED=true
# URL2MD_COORDINATION_REDIS_URL=        # 空白時沿用 REDIS_URL；Redis 不可用時降級為 process-local
# URL2MD_COORDINATION_NAMESPACE=brain:url2md
# URL2MD_HALF_OPEN_LEASE_S=5
#
# 回覆深度模式由請求的 mode 欄位決定（fast / standard / deep），預設 standard。
# 各模式的輪次與筆數寫在 brain/api/core/reply_modes.py，上面這些設定是它們的預設底值。
# WIKI_API_BASE_URL=https://wiki.david888.com/api
# WIKI_PUBLISH_ENABLED=true
# WIKI_PUBLISH_MAX_CHARS=100000

# === Agent 設定 ===
# 每輪決策：一次合併評估專案知識／網路／記憶需求、多語言、回覆語言與語氣。
# TURN_DECISIONS_ENABLED=true
# TURN_DECISIONS_RETRIEVAL_ENABLED=true
# TURN_DECISIONS_LANGUAGE_ENABLED=true
# TURN_DECISIONS_TONE_ENABLED=true
# 「再給我看看剛剛那張圖」：判定為是時把這段對話最近顯示過的圖放進附圖候選
# TURN_DECISIONS_PREVIOUS_PICTURE_ENABLED=true
# TURN_DECISIONS_TIMEOUT_SECONDS=2.0
# 回答附圖交給決策鏈從前 5 筆附圖檢索結果選一筆；關閉、逾時、失敗時照舊附第一筆引用的圖
# CHAT_REFERENCE_MEDIA_DECISION_ENABLED=true
# CHAT_REFERENCE_MEDIA_TIMEOUT_SECONDS=1.0
# CHAT_REFERENCE_MEDIA_MIN_CONFIDENCE=0.6
# TURN_DECISIONS_HOP_TIMEOUT_SECONDS=0.8
# TURN_DECISIONS_NOUL_POSITIVE_THRESHOLD=0.7
# TURN_DECISIONS_NOUL_NEGATIVE_THRESHOLD=0.1
# TURN_DECISIONS_CHOICE_CONFIDENCE_THRESHOLD=0.8
# TURN_DECISIONS_CHOICE_MARGIN_THRESHOLD=0.2
# AGENT_LOOP_MAX_ROUNDS=6                # 工具輪次上限
# CHAT_FORCE_KNOWLEDGE_SEARCH=true       # 一般使用者回合第一次呼叫強制走 search_knowledge，不讓模型憑記憶作答
# CHAT_PREFETCH_KNOWLEDGE_SEARCH=true    # 先用原句查好知識庫再叫 LLM，省一次只產生工具呼叫的 LLM 呼叫
# CHAT_PREFETCH_KNOWLEDGE_ALWAYS=true    # 有知識庫的專案一律先查，不看決策的 needs_knowledge；關掉回到是→先查、不確定→強制工具、否→不查
# 決策供應鏈依 Admin 設定的排序呼叫，provider、用途、耗時與狀態記入 usage.db
# JEV_BASE_URL=https://api.typesafe.ai   # Jev System One 的環境預設端點
# save_memory 授權閘門：由決策供應鏈判斷使用者是否明確要求記憶，全部失敗時退回關鍵字
# JEV_MEMORY_GATE_ENABLED=true
# JEV_GATE_TIMEOUT_SECONDS=2
# LIVE_AUDIO_LANGUAGE_ID_MODEL=gemini-3.5-flash-lite  # 知識庫有台語文件的專案，Live 用它聽中文字轉錄句是不是台語
# JEV_LANGUAGE_ENABLED=true              # 使用者訊息語言（zh/en/es）先用規則判，再背景由決策供應鏈校正（會送使用者訊息）
# ASR_FINAL_JUDGE_ENABLED=true           # Gemini Live 定稿與暫定字幕不同時，由決策供應鏈選擇；失敗照定稿
# ASR_FINAL_JUDGE_TIMEOUT_SECONDS=1.0    # 使用者在等這句送出；逾時照定稿
# AUTO_RECALL_USE_JEV_FILTER=true        # 記憶召回改由決策供應鏈篩相關記憶，省一次 LLM 摘要（會送記憶原文）
# 語音打斷：本地規則無法分類時由決策供應鏈判斷（Backend 轉呼叫 Brain），逾時或失敗維持中斷
# JEV_INTERRUPT_ENABLED=true
# JEV_INTERRUPT_TIMEOUT_SECONDS=0.6
# CHAT_ANSWER_PASS_EXCLUDES_KNOWLEDGE_SEARCH=true  # 查完知識庫後的回合拿掉 search_knowledge，其他工具（search_web 等）照常
# CHAT_MAX_FOLLOWUP_TOOL_ROUNDS=1        # 第一輪平行查完後最多再追加幾輪工具，之後只能作答（最多 2+N 次 LLM 呼叫）
# KNOWLEDGE_SEARCH_MERGE_LIMIT=5         # 多條查詢 RRF 融合後最多保留幾個片段給模型
# FORCED_TOOL_MODEL_OVERRIDE=            # 強制工具呼叫改用較快的小模型，例如 gemini-2.0-flash-lite
# FORCED_TOOL_MAX_TOKENS=400                # 第一輪可能一次呼叫多個工具，給足 token

# === 對話備份（VH-389；Brain）===
# 每天把所有專案的對話依語言匯出成 jsonl，保留最近 N 份；後台 ROOT 可預覽與手動觸發
# SESSION_BACKUP_ENABLED=true
# SESSION_BACKUP_HOUR=3                  # 台北時間幾點跑
# SESSION_BACKUP_KEEP=30
# SESSION_BACKUP_DIR=                    # 空白＝/data/backups/sessions（主機 brain/data/backups/sessions）

# === Dreaming 設定（memory consolidation）===
# DREAMING_ENABLED=false                # [optional] 是否啟用背景記憶整合
# DREAMING_TIMEZONE=Asia/Taipei          # 排程、每日防重與每日記憶／報告共用的時區
# DREAMING_MIN_RECALL_COUNT=1

# === Auto Recall ===
# AUTO_RECALL_ENABLED=true               # 預設 true；false 關閉記憶自動召回

# === 個資偵測（使用者訊息背景問 Clef）===
# PRIVACY_FILTER_ENABLED=false          # [optional] 預設關；true 才偵測
# PRIVACY_CLEF_TIMEOUT_SECONDS=3.0      # [optional] 每句等 Clef 的上限，逾時當作沒掃
# PRIVACY_MAX_INFLIGHT=2                # [optional] 同時在掃的上限，滿了跳過該句
# NO_ANSWER_JUDGE_ENABLED=true           # [optional] /chat 有知識庫引用時再判斷回覆是不是在說查不到，決定 no_answer；每輪約多 0.1–0.2 秒
# NO_ANSWER_JUDGE_TIMEOUT_SECONDS=0.8

# === 888a2a-lite Agent-to-Agent Network ===
# A2A_ENABLED=false                      # [optional] 是否啟用 A2A 背景橋接守護行程
# A2A_HUB_URL=https://a2a.david888.com   # [optional] 888a2a Hub 伺服器網址
# A2A_HUB_KEY=                           # [required for private circle] 只在註冊時送出的 secret；不可硬編碼
# A2A_ALLOW_PUBLIC_CIRCLE=false           # 明確 opt-in 才允許無 key 加入 public circle
# A2A_DISPLAY_NAME=openVman              # [optional] 在 A2A 網絡上的公開顯示名稱
# A2A_CREDENTIALS_PATH=/data/a2a/credentials.json # [optional] 本地憑證持久化路徑
# A2A_CREDENTIALS_ENCRYPTION_KEY=        # [optional] 憑證靜態加密金鑰（Fernet 32-bytes base64），未設定時沿用 SESSION_JWT_SECRET
# A2A_DEFAULT_PROJECT_ID=default         # [optional] A2A 任務預設 project ID
# A2A_DEFAULT_PERSONA_ID=                # [optional] A2A 任務預設回覆的角色 Persona ID（留空使用系統預設）
# A2A_QUEUE_DB_PATH=/data/a2a/work.db    # [optional] A2A 佇列 SQLite WAL 資料庫路徑
# A2A_QUEUE_RETENTION_DAYS=30            # [optional] terminal inbox/outbound record retention
# A2A_LEADER_LEASE_TTL_SECONDS=30        # [optional] Redis 單例領導者租約秒數
# A2A_ALLOW_GROUP_BROADCAST=false        # [optional] 明確 opt-in 才允許 Brain 發送群組廣播
# A2A_MAX_CONCURRENCY=4                  # [optional] Hub task worker 上限
# A2A_MAX_TASKS_PER_MINUTE=60            # [optional] outbound task/group rate limit
# A2A_MAX_DELEGATION_HOPS=3              # [optional] 防止 agent delegation loop

# Gemini Live：預設 gemini-3.8-live。改回 gemini-3.1-flash-live-preview 之類的
# 舊模型時，LIVE_GEMINI_THINKING_LEVEL 才會生效——3.8 一般版不接受該欄位。
# LIVE_GEMINI_MODEL=gemini-3.8-live
# LIVE_GEMINI_THINKING_LEVEL=
# LIVE_GEMINI_TRANSCRIPTION_LANGUAGES=zh-TW  # 語音轉錄語言（逗號分隔）；留空時 Gemini 的中文轉錄是簡體
# LIVE_GEMINI_PREFETCH_TIMEOUT_SECONDS=1.0  # 文字回合送給模型前的預取總時限；逾時的查詢改由模型自己查

# Jev / TypeSafe API
TYPESAFE_API_KEY=
