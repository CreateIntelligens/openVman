   "id": "drama-000131",
   "text": "自生自滅嗎",
   "audio": "/srv/818data/001_001_000131_000001.wav",
   "speech_language": "nan"
  },
  {
   "id": "drama-000169",
   "text": "我是見死不救 但我如果不這麼做 我們現在有可能活命嗎",
